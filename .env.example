# Which LLM provider to use: gemini | anthropic | openai | mock
# "gemini" is the default because Google AI Studio gives a free API key with a
# generous free-tier quota (no credit card required): https://aistudio.google.com/apikey
# "mock" needs no API key at all and returns canned responses — useful for
# testing the pipeline wiring without hitting a real model.
LLM_PROVIDER=gemini

# Only the key matching LLM_PROVIDER is required.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the default model per provider.
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4o-mini
